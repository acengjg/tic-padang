generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Destination {
  id          String   @id @default(cuid())
  name        String
  category    String
  rating      Float
  location    String
  image       String
  image360    String?
  description String
  price       String?
  lat         Float
  lng         Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  reviews     Review[]
  buddyPosts  TravelBuddyPost[]
}

model Promotion {
  id        String   @id @default(cuid())
  title     String
  discount  String
  image     String
  videoUrl  String?
  provider  String
  createdAt DateTime @default(now())
}

model Event {
  id          String   @id @default(cuid())
  name        String
  date        DateTime
  location    String
  image       String
  description String
  price       String?
  createdAt   DateTime @default(now())
}

model Article {
  id        String   @id @default(cuid())
  title     String
  content   String
  image     String
  category  String
  author    String   @default("Admin")
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  subjectTitle String?
  subjectDate  String?
  comments  Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  articleId String
  article   Article  @relation(fields: [articleId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Plan {
  id        String     @id @default(cuid())
  userId    String
  date      String
  title     String
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id])
  items     PlanItem[]
}

model PlanItem {
  id       String @id @default(cuid())
  planId   String
  time     String
  place    String
  activity String
  plan     Plan   @relation(fields: [planId], references: [id])
}


model User {
  id        String   @id @default(cuid())
  name      String
  level     Int      @default(1)
  points    Int      @default(0)
  avatar    String?
  createdAt DateTime @default(now())
  email     String   @unique
  password  String
  phone     String?
  updatedAt DateTime @updatedAt
  subjectTitle String?
  subjectDate  String?
  role      Role     @default(USER)

  plans     Plan[]
  reviews   Review[]
  comments  Comment[]
  
  // Story Relations
  stories       Story[]
  storyLikes    StoryLike[]
  storyComments StoryComment[]

  // Local Guide Marketplace Relations
  guide           Guide?
  bookings        Booking[]
  packageReviews  PackageReview[]
  messages        BookingMessage[]
  guideReviewsGiven    GuideReview[] @relation("GuideReviewsGiven")
  earnings        GuideEarning[]
  conversations   ConversationMember[]
  chatMessages    Message[]

  // Travel Buddy Relations
  buddyPosts      TravelBuddyPost[]
  buddyApplications TravelBuddyApplication[]
}

model Guide {
  id              String   @id @default(cuid())
  userId          String   @unique
  status          String   @default("PENDING") // PENDING, APPROVED, SUSPENDED
  verificationLevel String @default("BASIC") // BASIC, VERIFIED, PROFESSIONAL
  bio             String
  languages       String[] // ["Bahasa", "English"]
  specializations String[] // ["Culinary", "Cultural"]
  yearsExperience Int
  videoIntroUrl   String?
  certifications  String[] // URLs atau filenames
  averageRating   Float    @default(0)
  totalTours      Int      @default(0)
  totalReviews    Int      @default(0)
  responseRate    Float    @default(0)
  responseTime    Int?     // in minutes
  createdAt       DateTime @default(now())
  
  user            User     @relation(fields: [userId], references: [id])
  packages        TourPackage[]
  bookings        Booking[]
  reviews         PackageReview[]
  guideReviews    GuideReview[] @relation("GuideReviewsReceived")
  earnings        GuideEarning[]
  conversations   Conversation[]
}

model Conversation {
  id        String   @id @default(cuid())
  guideId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  subjectTitle String?
  subjectDate  String?
  
  guide     Guide?   @relation(fields: [guideId], references: [id])
  members   ConversationMember[]
  messages  Message[]
}

model ConversationMember {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  createdAt      DateTime @default(now())
  
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
  
  @@unique([conversationId, userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId        String
  content        String
  attachments    String[]
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
  
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation(fields: [senderId], references: [id])
}

model TourPackage {
  id              String   @id @default(cuid())
  guideId         String
  title           String
  category        String   // Cultural, Culinary, etc
  tags            String[] // family-friendly, etc
  description     String
  duration        Int      // in hours
  durationType    String   // HALF_DAY, FULL_DAY, MULTI_DAY
  maxParticipants Int
  basePrice       Int
  groupDiscount   Json?    // {5: 10, 10: 15}
  meetingPoint    String
  meetingPointLat Float?
  meetingPointLng Float?
  itinerary       Json     // [{time, place, activity, description}]
  inclusions      String[] // ["Transport", "Lunch", "Guide"]
  exclusions      String[] // ["Personal expenses"]
  requirements    Json     // {minAge, fitnessLevel, whatToBring}
  photos          String[] // URLs
  availableDays   String[] // ["MONDAY", "TUESDAY"]
  status          String   @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  averageRating   Float    @default(0)
  totalBookings   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  guide           Guide    @relation(fields: [guideId], references: [id])
  bookings        Booking[]
  reviews         PackageReview[]
}

model Booking {
  id              String   @id @default(cuid())
  packageId       String
  guideId         String
  userId          String
  bookingDate     DateTime @default(now())
  tourDate        DateTime
  participants    Int
  totalPrice      Int
  paymentStatus   String   @default("PENDING") // PENDING, PAID, REFUNDED
  paymentMethod   String?
  bookingStatus   String   @default("PENDING") // PENDING, CONFIRMED, COMPLETED, CANCELLED
  specialRequests String?
  travelerDetails Json?    // [{name, age, contact}]
  cancelledBy     String?  // USER, GUIDE, ADMIN
  cancelReason    String?
  refundAmount    Int?
  isReviewed      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  package         TourPackage @relation(fields: [packageId], references: [id])
  guide           Guide    @relation(fields: [guideId], references: [id])
  user            User     @relation(fields: [userId], references: [id])
  payment         Payment?
  messages        BookingMessage[]
  review          PackageReview?
}

model Payment {
  id              String   @id @default(cuid())
  bookingId       String   @unique
  amount          Int
  platformFee     Int      // Commission
  guidePayout     Int      // Amount to guide
  method          String?  // BANK_TRANSFER, EWALLET, CREDIT_CARD
  status          String   @default("PENDING") // PENDING, SUCCESS, FAILED
  paymentGateway  String?  // Midtrans, etc
  transactionId   String?
  paidAt          DateTime?
  releasedToGuide DateTime?
  createdAt       DateTime @default(now())
  
  booking         Booking  @relation(fields: [bookingId], references: [id])
}

model PackageReview {
  id              String   @id @default(cuid())
  packageId       String
  bookingId       String   @unique
  userId          String
  guideId         String
  overallRating   Int      // 1-5
  communicationRating Int?
  punctualityRating Int?
  knowledgeRating Int?
  valueRating     Int?
  comment         String?
  photos          String[]
  isVerified      Boolean  @default(true)
  helpfulCount    Int      @default(0)
  guideReply      String?
  guideReplyAt    DateTime?
  createdAt       DateTime @default(now())
  
  package         TourPackage @relation(fields: [packageId], references: [id])
  booking         Booking  @relation(fields: [bookingId], references: [id])
  user            User     @relation(fields: [userId], references: [id])
  guide           Guide    @relation(fields: [guideId], references: [id])
}

model GuideReview {
  id              String   @id @default(cuid())
  guideId         String
  reviewerId      String
  rating          Float
  comment         String?
  createdAt       DateTime @default(now())
  
  guide           Guide    @relation("GuideReviewsReceived", fields: [guideId], references: [id])
  reviewer        User     @relation("GuideReviewsGiven", fields: [reviewerId], references: [id])
}

model BookingMessage {
  id              String   @id @default(cuid())
  bookingId       String
  senderId        String   
  senderType      String   // USER or GUIDE
  message         String
  isAutoMessage   Boolean  @default(false)
  attachments     String[]
  createdAt       DateTime @default(now())
  
  booking         Booking  @relation(fields: [bookingId], references: [id])
  sender          User     @relation(fields: [senderId], references: [id])
}

model GuideEarning {
  id              String   @id @default(cuid())
  guideId         String
  userId          String?  // Optional: associated user for tracking
  amount          Int
  type            String   // BOOKING_PAYOUT, BONUS, PENALTY
  status          String   @default("PENDING") // PENDING, WITHDRAWN, CANCELLED
  withdrawnAt     DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  
  guide           Guide    @relation(fields: [guideId], references: [id])
  user            User?    @relation(fields: [userId], references: [id])
}

model Review {
  id            String      @id @default(cuid())
  userId        String
  destinationId String
  rating        Int
  comment       String
  createdAt     DateTime    @default(now())
  
  user          User        @relation(fields: [userId], references: [id])
  destination   Destination @relation(fields: [destinationId], references: [id])
}

enum Role {
  USER
  ADMIN
  GUIDE
}

model Story {
  id          String         @id @default(cuid())
  userId      String
  caption     String?
  location    String?
  viewCount   Int            @default(0)
  createdAt   DateTime       @default(now())
  expiresAt   DateTime?
  
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  media       StoryMedia[]
  likes       StoryLike[]
  comments    StoryComment[]
}

model StoryMedia {
  id        String   @id @default(cuid())
  storyId   String
  url       String
  type      String   // 'IMAGE' or 'VIDEO'
  order     Int      @default(0)
  
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
}

model StoryLike {
  id        String   @id @default(cuid())
  storyId   String
  userId    String
  createdAt DateTime @default(now())
  
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
}

model StoryComment {
  id        String   @id @default(cuid())
  storyId   String
  userId    String
  content   String
  createdAt DateTime @default(now())
  
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TravelBuddyPost {
  id              String   @id @default(cuid())
  userId          String
  destinationId   String?
  title           String
  description     String
  startDate       DateTime
  endDate         DateTime
  maxBuddies      Int      @default(2)
  status          String   @default("OPEN") // OPEN, CLOSED, CANCELLED
  requirements    String?
  budgetRange     String?  // Economy, Premium, etc
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User     @relation(fields: [userId], references: [id])
  destination     Destination? @relation(fields: [destinationId], references: [id])
  applications    TravelBuddyApplication[]
}

model TravelBuddyApplication {
  id              String   @id @default(cuid())
  postId          String
  userId          String
  message         String?
  status          String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt       DateTime @default(now())
  
  post            TravelBuddyPost @relation(fields: [postId], references: [id])
  user            User           @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}
