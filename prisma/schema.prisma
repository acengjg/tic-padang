generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Destination {
  id             String            @id @default(cuid())
  name           String
  category       String
  rating         Float
  location       String
  image          String
  image360       String?
  description    String
  price          String?
  lat            Float
  lng            Float
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  audioNarration String?
  hotspots       Json?
  isEnhanced     Boolean           @default(false)
  scenes         Json?
  videoUrl       String?
  footprints     Footprint[]
  reviews        Review[]
  buddyPosts     TravelBuddyPost[]
}

model Promotion {
  id        String   @id @default(cuid())
  title     String
  discount  String
  image     String
  provider  String
  createdAt DateTime @default(now())
  videoUrl  String?
}

model Event {
  id          String      @id @default(cuid())
  name        String
  date        DateTime
  location    String
  image       String
  description String
  price       String?
  createdAt   DateTime    @default(now())
  videoUrl    String?
  footprints  Footprint[]
}

model Article {
  id           String    @id @default(cuid())
  title        String
  content      String
  image        String
  category     String
  author       String    @default("Admin")
  date         DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  subjectDate  String?
  subjectTitle String?
  videoUrl     String?
  comments     Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  articleId String
  userId    String
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Plan {
  id        String     @id @default(cuid())
  userId    String
  date      String
  title     String
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id])
  items     PlanItem[]
}

model PlanItem {
  id       String @id @default(cuid())
  planId   String
  time     String
  place    String
  activity String
  plan     Plan   @relation(fields: [planId], references: [id])
}


model User {
  id                String                   @id @default(cuid())
  name              String
  level             Int                      @default(1)
  points            Int                      @default(0)
  avatar            String?
  createdAt         DateTime                 @default(now())
  email             String                   @unique
  password          String
  phone             String?
  updatedAt         DateTime                 @updatedAt
  role              Role                     @default(USER)
  subjectDate       String?
  subjectTitle      String?
  bookings          Booking[]
  messages          BookingMessage[]
  comments          Comment[]
  conversations     ConversationMember[]
  culinaryReviews   CulinaryReview[]
  footprints        Footprint[]
  guide             Guide?
  earnings          GuideEarning[]
  guideReviewsGiven GuideReview[]            @relation("GuideReviewsGiven")
  chatMessages      Message[]
  packageReviews    PackageReview[]
  plans             Plan[]
  reviews           Review[]
  souvenirOrders    SouvenirOrder[]
  souvenirVendors   SouvenirVendor[]
  culinarySpots     CulinarySpot[]
  stories           Story[]
  storyComments     StoryComment[]
  storyLikes        StoryLike[]
  buddyApplications TravelBuddyApplication[]
  buddyPosts        TravelBuddyPost[]
  badges            UserBadge[]
  culinaryOrders    CulinaryOrder[]
}

model Guide {
  id                String          @id @default(cuid())
  userId            String          @unique
  status            String          @default("PENDING")
  verificationLevel String          @default("BASIC")
  bio               String
  languages         String[]
  specializations   String[]
  yearsExperience   Int
  videoIntroUrl     String?
  certifications    String[]
  averageRating     Float           @default(0)
  totalTours        Int             @default(0)
  totalReviews      Int             @default(0)
  responseRate      Float           @default(0)
  responseTime      Int?
  createdAt         DateTime        @default(now())
  bookings          Booking[]
  conversations     Conversation[]
  user              User            @relation(fields: [userId], references: [id])
  earnings          GuideEarning[]
  guideReviews      GuideReview[]   @relation("GuideReviewsReceived")
  reviews           PackageReview[]
  packages          TourPackage[]
}

model Conversation {
  id           String               @id @default(cuid())
  guideId      String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  subjectDate  String?
  subjectTitle String?
  guide        Guide?               @relation(fields: [guideId], references: [id])
  members      ConversationMember[]
  messages     Message[]
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  attachments    String[]
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation(fields: [senderId], references: [id])
}

model TourPackage {
  id              String          @id @default(cuid())
  guideId         String
  title           String
  category        String
  tags            String[]
  description     String
  duration        Int
  durationType    String
  maxParticipants Int
  basePrice       Int
  groupDiscount   Json?
  meetingPoint    String
  meetingPointLat Float?
  meetingPointLng Float?
  itinerary       Json
  inclusions      String[]
  exclusions      String[]
  requirements    Json
  photos          String[]
  availableDays   String[]
  status          String          @default("ACTIVE")
  averageRating   Float           @default(0)
  totalBookings   Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  videoUrl        String?
  bookings        Booking[]
  reviews         PackageReview[]
  guide           Guide           @relation(fields: [guideId], references: [id])
}

model Booking {
  id              String           @id @default(cuid())
  packageId       String
  guideId         String
  userId          String
  bookingDate     DateTime         @default(now())
  tourDate        DateTime
  participants    Int
  totalPrice      Int
  paymentStatus   String           @default("PENDING")
  paymentMethod   String?
  bookingStatus   String           @default("PENDING")
  specialRequests String?
  travelerDetails Json?
  cancelledBy     String?
  cancelReason    String?
  refundAmount    Int?
  isReviewed      Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  guide           Guide            @relation(fields: [guideId], references: [id])
  package         TourPackage      @relation(fields: [packageId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
  messages        BookingMessage[]
  review          PackageReview?
  payment         Payment?
}

model Payment {
  id              String    @id @default(cuid())
  bookingId       String    @unique
  amount          Int
  platformFee     Int
  guidePayout     Int
  method          String?
  status          String    @default("PENDING")
  paymentGateway  String?
  transactionId   String?
  paidAt          DateTime?
  releasedToGuide DateTime?
  createdAt       DateTime  @default(now())
  booking         Booking   @relation(fields: [bookingId], references: [id])
}

model PackageReview {
  id                  String      @id @default(cuid())
  packageId           String
  bookingId           String      @unique
  userId              String
  guideId             String
  overallRating       Int
  communicationRating Int?
  punctualityRating   Int?
  knowledgeRating     Int?
  valueRating         Int?
  comment             String?
  photos              String[]
  isVerified          Boolean     @default(true)
  helpfulCount        Int         @default(0)
  guideReply          String?
  guideReplyAt        DateTime?
  createdAt           DateTime    @default(now())
  booking             Booking     @relation(fields: [bookingId], references: [id])
  guide               Guide       @relation(fields: [guideId], references: [id])
  package             TourPackage @relation(fields: [packageId], references: [id])
  user                User        @relation(fields: [userId], references: [id])
}

model GuideReview {
  id         String   @id @default(cuid())
  guideId    String
  reviewerId String
  rating     Float
  comment    String?
  createdAt  DateTime @default(now())
  guide      Guide    @relation("GuideReviewsReceived", fields: [guideId], references: [id])
  reviewer   User     @relation("GuideReviewsGiven", fields: [reviewerId], references: [id])
}

model BookingMessage {
  id            String   @id @default(cuid())
  bookingId     String
  senderId      String
  senderType    String
  message       String
  isAutoMessage Boolean  @default(false)
  attachments   String[]
  createdAt     DateTime @default(now())
  booking       Booking  @relation(fields: [bookingId], references: [id])
  sender        User     @relation(fields: [senderId], references: [id])
}

model GuideEarning {
  id          String    @id @default(cuid())
  guideId     String
  userId      String?
  amount      Int
  type        String
  status      String    @default("PENDING")
  withdrawnAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  guide       Guide     @relation(fields: [guideId], references: [id])
  user        User?     @relation(fields: [userId], references: [id])
}

model Review {
  id            String      @id @default(cuid())
  userId        String
  destinationId String
  rating        Int
  comment       String
  createdAt     DateTime    @default(now())
  destination   Destination @relation(fields: [destinationId], references: [id])
  user          User        @relation(fields: [userId], references: [id])
}

model Story {
  id        String         @id @default(cuid())
  userId    String
  caption   String?
  location  String?
  viewCount Int            @default(0)
  createdAt DateTime       @default(now())
  expiresAt DateTime?
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments  StoryComment[]
  likes     StoryLike[]
  media     StoryMedia[]
}

model StoryMedia {
  id      String @id @default(cuid())
  storyId String
  url     String
  type    String
  order   Int    @default(0)
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)
}

model StoryLike {
  id        String   @id @default(cuid())
  storyId   String
  userId    String
  createdAt DateTime @default(now())
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
}

model StoryComment {
  id        String   @id @default(cuid())
  storyId   String
  userId    String
  content   String
  createdAt DateTime @default(now())
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TravelBuddyPost {
  id            String                   @id @default(cuid())
  userId        String
  destinationId String?
  title         String
  description   String
  startDate     DateTime
  endDate       DateTime
  maxBuddies    Int                      @default(2)
  status        String                   @default("OPEN")
  requirements  String?
  budgetRange   String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  applications  TravelBuddyApplication[]
  destination   Destination?             @relation(fields: [destinationId], references: [id])
  user          User                     @relation(fields: [userId], references: [id])
}

model TravelBuddyApplication {
  id        String          @id @default(cuid())
  postId    String
  userId    String
  message   String?
  status    String          @default("PENDING")
  createdAt DateTime        @default(now())
  post      TravelBuddyPost @relation(fields: [postId], references: [id])
  user      User            @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model CulinarySpot {
  id             String           @id @default(cuid())
  name           String
  category       String
  description    String
  priceRange     String
  address        String
  lat            Float
  lng            Float
  image          String
  images         String[]
  facilities     String[]
  openingHours   Json?
  menuHighlights Json?
  contact        String?
  rating         Float            @default(0)
  totalReviews   Int              @default(0)
  isHalal        Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  videoUrl       String?
  status         String           @default("APPROVED") // PENDING, APPROVED, REJECTED
  userId         String?
  user           User?            @relation(fields: [userId], references: [id])
  reviews        CulinaryReview[]
  footprints     Footprint[]
  menu           CulinaryMenu[]
  orders         CulinaryOrder[]
}

model CulinaryMenu {
  id          String       @id @default(cuid())
  spotId      String
  name        String
  description String
  price       Int
  image       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  spot        CulinarySpot @relation(fields: [spotId], references: [id])
  orderItems  CulinaryOrderItem[]
}

model CulinaryReview {
  id             String       @id @default(cuid())
  spotId         String
  userId         String
  rating         Float
  tasteRating    Float?
  serviceRating  Float?
  ambienceRating Float?
  comment        String
  photos         String[]
  createdAt      DateTime     @default(now())
  spot           CulinarySpot @relation(fields: [spotId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
}

model CulinaryOrder {
  id              String              @id @default(cuid())
  userId          String
  spotId          String
  totalPrice      Int
  status          String              @default("PENDING") // PENDING, CONFIRMED, READY, COMPLETED, CANCELLED
  paymentStatus   String              @default("PENDING")
  note            String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User                @relation(fields: [userId], references: [id])
  spot            CulinarySpot        @relation(fields: [spotId], references: [id])
  items           CulinaryOrderItem[]
}

model CulinaryOrderItem {
  id        String       @id @default(cuid())
  orderId   String
  menuId    String
  quantity  Int
  price     Int
  note      String?
  order     CulinaryOrder @relation(fields: [orderId], references: [id])
  menu      CulinaryMenu  @relation(fields: [menuId], references: [id])
}

model Footprint {
  id             String        @id @default(cuid())
  userId         String
  destinationId  String?
  culinarySpotId String?
  eventId        String?
  type           VisitType     @default(MANUAL)
  visitDate      DateTime      @default(now())
  duration       Int?
  photos         String[]
  rating         Float?
  note           String?
  context        String?
  lat            Float
  lng            Float
  pointsEarned   Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  culinarySpot   CulinarySpot? @relation(fields: [culinarySpotId], references: [id])
  destination    Destination?  @relation(fields: [destinationId], references: [id])
  event          Event?        @relation(fields: [eventId], references: [id])
  user           User          @relation(fields: [userId], references: [id])
}

model Badge {
  id          String      @id @default(cuid())
  name        String
  description String
  image       String
  category    String
  threshold   Int
  tier        BadgeTier   @default(BRONZE)
  createdAt   DateTime    @default(now())
  users       UserBadge[]
}

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  unlockedAt DateTime @default(now())
  badge      Badge    @relation(fields: [badgeId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, badgeId])
}

model SouvenirVendor {
  id          String            @id @default(cuid())
  name        String
  description String
  image       String
  location    String
  videoUrl    String?
  lat         Float?
  lng         Float?
  contact     String?
  rating      Float             @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  status      String            @default("PENDING")
  userId      String
  orders      SouvenirOrder[]
  products    SouvenirProduct[]
  user        User              @relation(fields: [userId], references: [id])
}

model SouvenirProduct {
  id          String              @id @default(cuid())
  vendorId    String
  name        String
  description String
  price       Int
  images      String[]
  category    String
  stock       Int                 @default(0)
  rating      Float               @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  orderItems  SouvenirOrderItem[]
  vendor      SouvenirVendor      @relation(fields: [vendorId], references: [id])
}

model SouvenirOrder {
  id              String              @id @default(cuid())
  userId          String
  vendorId        String
  totalPrice      Int
  status          String              @default("PENDING")
  paymentStatus   String              @default("PENDING")
  shippingAddress String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User                @relation(fields: [userId], references: [id])
  vendor          SouvenirVendor      @relation(fields: [vendorId], references: [id])
  items           SouvenirOrderItem[]
}

model SouvenirOrderItem {
  id        String          @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Int
  order     SouvenirOrder   @relation(fields: [orderId], references: [id])
  product   SouvenirProduct @relation(fields: [productId], references: [id])
}

enum Role {
  USER
  ADMIN
  GUIDE
  VENDOR
  CULINARY
}

enum VisitType {
  GPS_AUTO
  QR_CODE
  MANUAL
}

enum BadgeTier {
  BRONZE
  SILVER
  GOLD
  DIAMOND
  LEGEND
}
