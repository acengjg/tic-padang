
# Ganti 'postgres', 'password', dan '5432' sesuai config lokal Anda
DATABASE_URL="postgresql://postgres:12345678@localhost:5432/sipadang?schema=public"
PORT=3001
JWT_SECRET="tik_padang_secret_key_123"
REFRESH_SECRET="tik_padang_refresh_secret_key_456"

# Konfigurasi Google OAuth (Wajib diisi untuk Login Google)
# Dapatkan kredensial di: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="GANTI_DENGAN_GOOGLE_CLIENT_ID_ANDA"
GOOGLE_CLIENT_SECRET="GANTI_DENGAN_GOOGLE_CLIENT_SECRET_ANDA"
